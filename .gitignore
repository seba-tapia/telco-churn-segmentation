# ============================================================
# Python
# ============================================================
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/

# ============================================================
# Virtual environments
# ============================================================
.venv/
venv/
env/
ENV/

# ============================================================
# Jupyter
# ============================================================
.ipynb_checkpoints/

# ============================================================
# Environment variables / secrets
# ============================================================
.env
.env.*
!.env.example

# ============================================================
# Data
# ============================================================
# Processed data is generated by run_pipeline.py and can always
# be reproduced from data/raw/ — no need to version it.
data/processed/*
!data/processed/.gitkeep

# Raw data: kept tracked by default since it's the public Telco
# dataset (small, needed to reproduce results out of the box).
# Uncomment the line below if you'd rather not commit data files
# at all and document how to download it instead.
# data/raw/*.csv

# ============================================================
# Trained model artifacts
# ============================================================
# These are generated by `python run_pipeline.py --step all`.
# Ignored by default so the repo doesn't carry binary artifacts
# that go stale the moment the training data changes.
# Comment these two lines out if you specifically want to ship
# a working model artifact with the portfolio repo.
models/*.joblib
models/*.json
!models/.gitkeep

# ============================================================
# IDE / editor
# ============================================================
.vscode/
.idea/
*.swp

# ============================================================
# OS
# ============================================================
.DS_Store
Thumbs.db

# ============================================================
# Logs
# ============================================================
*.log
